# Samakan dengan koneksi database yang dipakai Laravel (.env, DB_* )
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_DATABASE=db_marcom_analytics

# Kunci rahasia untuk komunikasi Laravel -> Python.
# Generate string acak, lalu salin nilai yang SAMA ke .env Laravel (ANALYTICS_API_KEY).
ANALYTICS_API_KEY=ganti-dengan-string-acak-yang-panjang

# =============================================================================
# Meta Graph API (Instagram Graph API) -- untuk fitur engagement REAL (akun
# Instagram Business/Creator MILIK SR GROUP SENDIRI, bukan kompetitor).
# Panduan lengkap cara mendapatkan nilai-nilai ini: lihat META_SETUP.md
# =============================================================================

# WAJIB. Access token jangka panjang (long-lived, ~60 hari, bisa diperpanjang)
# dari Meta Developer App yang sudah terhubung ke Instagram Business/Creator
# Account. TANPA ini, endpoint /meta/sync akan gagal dengan pesan jelas
# "META_ACCESS_TOKEN dan/atau META_IG_BUSINESS_ID belum diset di .env".
META_ACCESS_TOKEN=

# WAJIB. ID akun Instagram Business/Creator (BUKAN username) -- didapat lewat
# Graph API Explorer setelah akun terhubung ke Facebook Page yang kamu kelola.
# Lihat META_SETUP.md langkah 4.
META_IG_BUSINESS_ID=

# OPSIONAL. Versi Graph API yang dipakai. Meta rutin merilis versi baru &
# men-deprecate versi lama (biasanya ~2 tahun) -- kalau suatu saat sync mulai
# gagal dengan pesan soal versi API, cek versi terbaru di
# https://developers.facebook.com/docs/graph-api/changelog lalu update ini.
META_GRAPH_API_VERSION=v23.0

# OPSIONAL. Daftar metric /insights yang diminta per post, dipisah koma. Meta
# cukup sering ganti nama metric ini (contoh: impressions & video_views
# di-deprecate mulai v22, diganti "views"). Kalau sync sering gagal untuk
# metric tertentu, coba kurangi daftar ini -- kode akan otomatis fallback ke
# "reach" saja kalau metric di bawah ini ditolak Graph API.
META_MEDIA_INSIGHTS_METRICS=reach,saved,shares,views
