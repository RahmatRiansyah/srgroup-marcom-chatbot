APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mesin analisis Python (FastAPI) - lihat srgroup-marcom-analytics-service
ANALYTICS_API_URL=http://127.0.0.1:8001
ANALYTICS_API_KEY=samakan-dengan-ANALYTICS_API_KEY-di-.env-service-python
ANALYTICS_API_TIMEOUT=10

# Engine chatbot: Claude (utama) -> Groq (fallback 1) -> Gemini (fallback 2).
# Ketiganya dipanggil lewat tool use/function calling yang sama (lihat
# UsesAnalyticsTools) supaya kualitas jawaban konsisten siapa pun yang menjawab.

# Claude (Anthropic) - WAJIB diisi, ini engine utama chatbot
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq (GroqCloud, format API OpenAI-compatible) - fallback 1 kalau Claude gagal.
# Bikin key gratis di console.groq.com, tidak perlu kartu kredit. Kuota gratis
# jauh lebih lega dari Gemini (puluhan request/menit, ribuan/hari).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (Google) - fallback 2, dipakai hanya kalau Claude & Groq berdua gagal.
# Kuota gratis Gemini kecil (~20 request/hari), jadi diletakkan paling akhir.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tavily (API search khusus untuk AI agent) - dipakai GeminiService untuk tool
# web_search custom, karena grounding google_search bawaan Gemini belum bisa
# digabung dengan tool custom kita (getTrend, dst). Daftar gratis di
# tavily.com: 1.000 kredit/bulan, TANPA kartu kredit.
TAVILY_API_KEY=
