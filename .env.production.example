# =============================================================================
# TEMPLATE .env UNTUK PRODUCTION -- bukan pengganti .env, cuma referensi nilai
# yang WAJIB beda dari .env lokal/dev. Isi APP_KEY & semua *_API_KEY/PASSWORD
# di sini SENGAJA dikosongkan -- generate/rotate sendiri, JANGAN copy dari
# .env dev manapun (lihat catatan audit soal rotate key).
# =============================================================================

APP_NAME="SR GROUP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ganti-dengan-domain-production-kalian

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# production: jangan pernah "debug" -- query SQL & stack trace tidak perlu
# tercatat sedetail itu tiap request, dan berisiko menyimpan data sensitif
# (payload chat user, dsb) di storage/logs.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true kalau production sudah di belakang HTTPS (harusnya selalu ya) --
# tanpa ini, cookie sesi bisa ikut terkirim lewat HTTP biasa dan disadap MITM.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Rotate & isi ulang semua nilai di bawah ini (lihat catatan audit #3) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

ANALYTICS_API_URL=
ANALYTICS_API_KEY=

ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
